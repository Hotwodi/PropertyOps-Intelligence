<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="poi_tenant_view_tree" model="ir.ui.view">
        <field name="name">poi.tenant.view.tree</field>
        <field name="model">poi.tenant</field>
        <field name="arch" type="xml">
            <tree string="Tenants">
                <field name="name"/>
                <field name="company_name"/>
                <field name="contact_phone"/>
                <field name="contact_email"/>
                <field name="credit_score"/>
                <field name="tenant_since"/>
                <field name="total_lease_count"/>
                <field name="ai_churn_risk" widget="percentage" decoration-danger="ai_churn_risk &gt; 50"/>
            </tree>
        </field>
    </record>

    <record id="poi_tenant_view_form" model="ir.ui.view">
        <field name="name">poi.tenant.view.form</field>
        <field name="model">poi.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant">
                <header/>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Tenant Name"/>
                        <h1><field name="name" placeholder="e.g. Acme Corp"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="company_name"/>
                            <field name="contact_phone"/>
                            <field name="contact_email"/>
                        </group>
                        <group>
                            <field name="credit_score"/>
                            <field name="tenant_since"/>
                            <field name="ai_churn_risk" widget="percentage"/>
                            <field name="total_lease_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Leases">
                            <field name="lease_ids">
                                <tree>
                                    <field name="lease_number"/>
                                    <field name="property_id"/>
                                    <field name="unit_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="status" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="poi_tenant_action" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">poi.tenant</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tenant
            </p>
            <p>
                Tenants are the individuals or companies that occupy your units under lease agreements.
            </p>
        </field>
    </record>
</odoo>
