<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="poi_unit_view_tree" model="ir.ui.view">
        <field name="name">poi.unit.view.tree</field>
        <field name="model">poi.unit</field>
        <field name="arch" type="xml">
            <list string="Units" decoration-success="status=='occupied'" decoration-danger="status=='vacant'" decoration-warning="status=='maintenance'">
                <field name="property_id"/>
                <field name="name"/>
                <field name="unit_number"/>
                <field name="floor"/>
                <field name="sqft"/>
                <field name="monthly_rent" sum="Total Monthly Rent"/>
                <field name="ai_market_rent_estimate"/>
                <field name="status" widget="badge" decoration-success="status=='occupied'" decoration-danger="status=='vacant'" decoration-warning="status=='maintenance'" decoration-info="status=='reserved'"/>
                <field name="last_turnover_date"/>
            </list>
        </field>
    </record>

    <record id="poi_unit_view_form" model="ir.ui.view">
        <field name="name">poi.unit.view.form</field>
        <field name="model">poi.unit</field>
        <field name="arch" type="xml">
            <form string="Unit">
                <header/>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Unit Name"/>
                        <h1><field name="name" placeholder="e.g. Suite 200"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="unit_number"/>
                            <field name="floor"/>
                            <field name="status" widget="radio"/>
                        </group>
                        <group>
                            <field name="sqft"/>
                            <field name="monthly_rent"/>
                            <field name="ai_market_rent_estimate"/>
                            <field name="last_turnover_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="poi_unit_action" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">poi.unit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new unit
            </p>
            <p>
                Units represent rentable suites or apartments within a property.
            </p>
        </field>
    </record>
</odoo>
