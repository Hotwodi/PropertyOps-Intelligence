<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="poi_maintenance_request_view_tree" model="ir.ui.view">
        <field name="name">poi.maintenance.request.view.tree</field>
        <field name="model">poi.maintenance.request</field>
        <field name="arch" type="xml">
            <list string="Maintenance Requests" decoration-danger="priority=='emergency'" decoration-warning="priority=='high'">
                <field name="name"/>
                <field name="property_id"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="request_type"/>
                <field name="priority" widget="badge" decoration-danger="priority=='emergency'" decoration-warning="priority=='high'" decoration-info="priority=='medium'" decoration-success="priority=='low'"/>
                <field name="ai_urgency_score" widget="percentage"/>
                <field name="ai_suggested_vendor"/>
                <field name="assigned_to"/>
                <field name="state" widget="badge" decoration-success="state=='completed'" decoration-info="state=='in_progress'" decoration-warning="state=='assigned'" decoration-muted="state=='submitted'"/>
                <field name="created_date"/>
            </list>
        </field>
    </record>

    <record id="poi_maintenance_request_view_form" model="ir.ui.view">
        <field name="name">poi.maintenance.request.view.form</field>
        <field name="model">poi.maintenance.request</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <header>
                    <button name="action_triage" type="object" string="Triaged" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary" invisible="state != 'triaged'"/>
                    <button name="action_start" type="object" string="Start Work" class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-success" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,triaged,assigned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Request Title"/>
                        <h1><field name="name" placeholder="e.g. Broken HVAC in Suite 200"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="unit_id"/>
                            <field name="tenant_id"/>
                            <field name="request_type"/>
                            <field name="priority" widget="radio"/>
                        </group>
                        <group>
                            <field name="ai_urgency_score" widget="percentage"/>
                            <field name="ai_suggested_vendor"/>
                            <field name="assigned_to"/>
                            <field name="created_date" readonly="1"/>
                            <field name="completed_date" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the issue in detail..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="poi_maintenance_request_action" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">poi.maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new maintenance request
            </p>
            <p>
                Track work orders from submission through triage, assignment and completion with AI urgency scoring.
            </p>
        </field>
    </record>
</odoo>
